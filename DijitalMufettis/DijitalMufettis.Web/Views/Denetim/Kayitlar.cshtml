@model DijitalMufettis.Web.Models.SonucViewModel
@{
    ViewData["Title"] = "Denetim Sonucu";
}

<h1>Denetim Sonucu</h1>
<a asp-action="Yukle" class="btn btn-secondary mb-3">← Yeni dosya</a>

<h3>Tespit Edilen İhlaller <span class="badge bg-danger">@Model.Ihlaller.Count</span></h3>

@if (Model.Ihlaller.Count == 0)
{
    <div class="alert alert-success">Bu kuralda ihlal bulunamadı. 🎉</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr><th>Personel</th><th>Tarih</th><th>İhlal</th><th>Detay</th></tr>
        </thead>
        <tbody>
            @foreach (var ihlal in Model.Ihlaller)
            {
                <tr>
                    <td>@ihlal.Personel</td>
                    <td>@ihlal.Tarih.ToString("dd.MM.yyyy")</td>
                    <td><span class="badge bg-warning text-dark">@ihlal.Tip</span></td>
                    <td>@ihlal.Detay</td>
                </tr>
            }
        </tbody>
    </table>
}

<h3 class="mt-4">Okunan Kayıtlar <span class="text-muted">(@Model.Kayitlar.Count)</span></h3>
<table class="table table-sm table-bordered">
    <thead>
        <tr><th>Personel</th><th>Tarih</th><th>Giriş</th><th>Çıkış</th></tr>
    </thead>
    <tbody>
        @foreach (var kayit in Model.Kayitlar)
        {
            <tr>
                <td>@kayit.Personel</td>
                <td>@kayit.Tarih.ToString("dd.MM.yyyy")</td>
                <td>@kayit.Giris</td>
                <td>@kayit.Cikis</td>
            </tr>
        }
    </tbody>
</table>