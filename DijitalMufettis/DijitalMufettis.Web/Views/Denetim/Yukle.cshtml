@{
    ViewData["Title"] = "PDKS Dosyası Yükle";
}

<h1>PDKS Dosyası Yükle</h1>
<p class="text-muted">Denetlenecek Excel (.xlsx) dosyasını seçip yükleyin.</p>

<form asp-controller="Denetim" asp-action="Kayitlar" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <input type="file" name="dosya" accept=".xlsx,.xlsm" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Yükle ve Oku</button>
</form>